        {p = 1.00, t = "ดาวน์โหลดสำเร็จ! 100%"}
    }
    
    for _, step in ipairs(steps) do
        StatusLabel.Text = step.t
        TweenService:Create(BarFill, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(step.p, 0, 1, 0)
        }):Play()
        task.wait(0.7)
    end
    
    task.wait(0.4)
    LoaderGui:Destroy()
end

